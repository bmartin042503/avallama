<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Color codes can be specified in the SolidColorBrush and Color tags. The Color tag also supports transparency. (#AA000000) -->
    <ResourceDictionary.ThemeDictionaries>
        <!-- Seed: #623079 -->

        <!-- Light theme colors -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="Selection">#80E4B7F3</Color> <!-- 50% opacity -->
            <SolidColorBrush x:Key="Primary">#755085</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceTint">#755085</SolidColorBrush>
            <SolidColorBrush x:Key="OnPrimary">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryContainer">#F7D8FF</SolidColorBrush>
            <SolidColorBrush x:Key="OnPrimaryContainer">#5C396C</SolidColorBrush>
            <SolidColorBrush x:Key="Secondary">#69596D</SolidColorBrush>
            <SolidColorBrush x:Key="OnSecondary">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryContainer">#F1DCF4</SolidColorBrush>
            <SolidColorBrush x:Key="OnSecondaryContainer">#504255</SolidColorBrush>
            <SolidColorBrush x:Key="Tertiary">#815251</SolidColorBrush>
            <SolidColorBrush x:Key="OnTertiary">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="TertiaryContainer">#FFDAD8</SolidColorBrush>
            <SolidColorBrush x:Key="OnTertiaryContainer">#663B3A</SolidColorBrush>
            <SolidColorBrush x:Key="Error">#BA1A1A</SolidColorBrush>
            <SolidColorBrush x:Key="OnError">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorContainer">#FFDAD6</SolidColorBrush>
            <SolidColorBrush x:Key="OnErrorContainer">#93000A</SolidColorBrush>
            <SolidColorBrush x:Key="Success">#1FA13D</SolidColorBrush>
            <SolidColorBrush x:Key="OnSuccess">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="Background">#FFF7FB</SolidColorBrush>
            <SolidColorBrush x:Key="OnBackground">#1E1A1F</SolidColorBrush>
            <SolidColorBrush x:Key="Surface">#FFF7FB</SolidColorBrush>
            <SolidColorBrush x:Key="OnSurface">#1E1A1F</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceVariant">#EBDFEA</SolidColorBrush>
            <SolidColorBrush x:Key="OnSurfaceVariant">#4C444D</SolidColorBrush>
            <SolidColorBrush x:Key="Outline">#7D747E</SolidColorBrush>
            <SolidColorBrush x:Key="OutlineVariant">#CEC3CD</SolidColorBrush>
            <SolidColorBrush x:Key="Shadow">#000000</SolidColorBrush>
            <SolidColorBrush x:Key="Scrim">#000000</SolidColorBrush>
            <SolidColorBrush x:Key="InverseSurface">#342F34</SolidColorBrush>
            <SolidColorBrush x:Key="InverseOnSurface">#F8EEF5</SolidColorBrush>
            <SolidColorBrush x:Key="InversePrimary">#E4B7F3</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryFixed">#F7D8FF</SolidColorBrush>
            <SolidColorBrush x:Key="OnPrimaryFixed">#2D0B3D</SolidColorBrush>
            <SolidColorBrush x:Key="PrimaryFixedDim">#E4B7F3</SolidColorBrush>
            <SolidColorBrush x:Key="OnPrimaryFixedVariant">#5C396C</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryFixed">#F1DCF4</SolidColorBrush>
            <SolidColorBrush x:Key="OnSecondaryFixed">#231728</SolidColorBrush>
            <SolidColorBrush x:Key="SecondaryFixedDim">#D4C0D7</SolidColorBrush>
            <SolidColorBrush x:Key="OnSecondaryFixedVariant">#504255</SolidColorBrush>
            <SolidColorBrush x:Key="TertiaryFixed">#FFDAD8</SolidColorBrush>
            <SolidColorBrush x:Key="OnTertiaryFixed">#331111</SolidColorBrush>
            <SolidColorBrush x:Key="TertiaryFixedDim">#F5B7B5</SolidColorBrush>
            <SolidColorBrush x:Key="OnTertiaryFixedVariant">#663B3A</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceDim">#E1D7DF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceBright">#FFF7FB</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerLowest">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerLow">#FBF1F8</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainer">#F5EBF3</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerHigh">#EFE5ED</SolidColorBrush>
            <SolidColorBrush x:Key="SurfaceContainerHighest">#E9E0E7</SolidColorBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
